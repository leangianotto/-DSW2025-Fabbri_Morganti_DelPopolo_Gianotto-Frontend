/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "jest"
    ],
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "files": [
    "test.ts", 
    "src/main.ts"
  ],

  "exclude": [
    "node_modules",
    "cypress" // se asegura de que la carpeta Cypress esté excluida aquí
  ]
}
